# WA-USERAUTH Environment Configuration

# Server Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
BASE_URL=http://localhost:3000

# Administrative Security
ADMIN_PASSWORD=change_this_admin_password_123!
ADMIN_SESSION_SECRET=super_secret_admin_session_key_replace_in_production

# Application Identification & Server-to-Server Verification Secret
# Format: appKey:appSecret (multiple comma-separated allowed)
ALLOWED_APPS=app_default_demo:secret_default_demo_key_998877

# CORS Configuration (comma-separated allowed origins, or * in dev mode)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CAPTCHA Configuration (Cloudflare Turnstile)
# Set CAPTCHA_PROVIDER to "turnstile" for live production verification, or "mock" for local testing.
CAPTCHA_PROVIDER=mock
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# OTP Security & Rate Limiting Configuration
OTP_MIN_INTERVAL_SECONDS=60
OTP_MAX_15MIN=3
OTP_MAX_1HR=5
OTP_MAX_24HR=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_EXPIRY_SECONDS=300
RATE_LIMIT_IP_MAX_15MIN=30

# WhatsApp Berry Transport
WHATSAPP_ADAPTER=berry
WHATSAPP_SESSION_ID=wa_userauth_session
WHATSAPP_SESSION_PATH=./data/berry_auth
WHATSAPP_DATABASE_PATH=./data/berry_store.db
